# SOLO CONFIGURAR EN EL SERVIDOR. NUNCA EN LA PC DE LOS USUARIOS.
VLUX_MODE=production
VLUX_DB=sqlserver
VLUX_HOST=127.0.0.1
VLUX_PORT=8765
VLUX_PUBLIC_ORIGIN=https://finanzas.vlux.com.mx
# Ejemplo integrado con Windows (si la cuenta de servicio tiene permisos):
VLUX_SQLSERVER_CONNECTION=DRIVER={ODBC Driver 18 for SQL Server};SERVER=HOST\\INSTANCIA;DATABASE=VLUX_Finanzas;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=no;
# Alternativa SQL Auth SOLO como variable secreta del servicio, NUNCA en archivos compartidos:
# DRIVER={ODBC Driver 18 for SQL Server};SERVER=tcp:servidor,1433;DATABASE=VLUX_Finanzas;UID=usuario_servicio;PWD=USAR_SECRET_MANAGER;Encrypt=yes;TrustServerCertificate=no;
# SOLO primer inicio sin usuarios:
VLUX_BOOTSTRAP_ADMIN_NAME=Administrador VLUX
VLUX_BOOTSTRAP_ADMIN_EMAIL=admin@vlux.com.mx
VLUX_BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_CONTRASENA_UNICA_14_CARACTERES
